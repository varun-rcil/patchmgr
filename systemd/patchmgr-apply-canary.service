[Unit]
Description=patchmgr - apply approved patches to the canary ring
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=patchmgr
Group=patchmgr
EnvironmentFile=/etc/patchmgr/patchmgr.env
# Vault password so unattended runs can decrypt group_vars/windows_vault.yml
Environment=ANSIBLE_VAULT_PASSWORD_FILE=/etc/patchmgr/vault_pass
WorkingDirectory=/opt/patchmgr/ansible
ExecStart=/opt/patchmgr/venv/bin/ansible-playbook playbooks/patch_apply.yml -l ring_canary -e target_ring=canary
ExecStartPost=/opt/patchmgr/venv/bin/ansible-playbook playbooks/patch_scan.yml -l ring_canary
TimeoutStartSec=10800

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/patchmgr /var/log/patchmgr /tmp
ReadOnlyPaths=/etc/patchmgr

[Install]
WantedBy=multi-user.target
